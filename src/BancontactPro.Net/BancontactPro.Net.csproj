<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".Net",""))</RootNamespace>

    <!-- Package identity -->
    <PackageId>BancontactPro.Net</PackageId>
    <!-- Version is derived automatically from git tags by MinVer (tag format: v0.1.2) -->
    <Authors>DeWall88</Authors>
    <Copyright>© 2026 DeWall88</Copyright>
    <Description>A strongly-typed .NET 10 client for the Bancontact Pro Merchant APIs (Payment, Refund, Reconciliation) and its QR products (On a Display, On a Receipt, Static QR, Top Up, Invoice): per-product credentials, JWS-signed refund and reconciliation calls, JWKS-verified callbacks, QR payload URLs, and dependency injection registration.</Description>
    <PackageReleaseNotes>0.2.0-preview.1: Credentials now come from an IBancontactCredentialsProvider, read on every call: AddBancontactPro (generic or factory overload) for hosts that supply their own, with no startup validation, nothing captured and a JWKS client that follows the environment; AddBancontactProIntegration(IConfiguration) for static settings. IBancontactClientFactory is asynchronous. New BancontactEndpoints; PaymentLinkBuilder builds QR payload URLs for the configured environment. Payment, Refund and Reconciliation APIs (v3); per-product API key and PPID; callback verification against the Bancontact JWKS. Payment creation and callback verification verified against the pre-production environment (a real callback: header..signature form, a path claim that is the callback URL).</PackageReleaseNotes>
    <PackageTags>bancontact;bancontactpro;payconiq;payments;belgium;qr;client;webhooks;jws</PackageTags>

    <!-- Repository and project links -->
    <PackageProjectUrl>https://github.com/yvebrecht/BancontactPro.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yvebrecht/BancontactPro.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- README shown on NuGet.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Emit the XML doc file so consumers get IntelliSense tooltips -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Symbol package for source-stepping in debuggers -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Treat missing XML doc comments as build errors -->
    <WarningsAsErrors>CS1591</WarningsAsErrors>

    <!-- MinVer configuration -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Only Microsoft.Extensions.* (HttpClientFactory, options, configuration binding), not the whole ASP.NET Core
       framework, so the package also works in console apps and worker services. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
